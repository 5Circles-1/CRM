# Must inherit crm_app: not a superuser, no BYPASSRLS, not the table owner.
# The server refuses to start otherwise - see Database.assertNotBypassingRls().
#   create role crm_api login password '...' in role crm_app;
DATABASE_URL=postgresql://crm_api:change-me@localhost:5432/crm

# User with the `ops` role. Background jobs run as them, under RLS.
# Without this, jobs are disabled and the server logs a warning.
SERVICE_USER_ID=

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SESSION_COOKIE_NAME=crm_session

# Set true ONLY for local plain HTTP. Cookies are Secure otherwise.
# INSECURE_COOKIES=true

# Google Sheets service account, read-only scope.
# Share the sheet with the service account's email address.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

PG_POOL_MAX=10
