# Caddy reverse proxy: automatic HTTPS with Let's Encrypt.
# Install caddy, put this at /etc/caddy/Caddyfile, replace the domain,
# then: sudo systemctl reload caddy
crm.yourcompany.in {
    # ---- OPTIONAL: office-only access --------------------------------------
    # Uncomment the block below and replace the IP with your office's
    # STATIC public IP (ask your ISP; check it from the office at
    # https://ifconfig.me). Everyone outside then gets a refusal before even
    # seeing the login page. Multiple IPs: list them separated by spaces.
    # Note: a pan-India floor signing in from home or a phone cannot use
    # this - it is only for a single-office setup.
    #
    # @outside {
    #     not remote_ip 203.0.113.7
    # }
    # abort @outside
    # ------------------------------------------------------------------------

    reverse_proxy 127.0.0.1:8080

    # The CRM holds client PII: no indexing, no sniffing, no framing.
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        X-Robots-Tag "noindex, nofollow"
    }
}
